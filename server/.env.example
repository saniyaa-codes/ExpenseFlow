# =================================================================
# EXPENSEFLOW BACKEND SERVER ENVIRONMENT CONFIGURATION
# Copy this file to server/.env before starting the server
# =================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
# Client Frontend URL (For production use your Vercel/Netlify URL, or comma-separated for local testing e.g. http://localhost:5173,http://192.168.x.x:5173)
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB Connection String)
# Local: mongodb://localhost:27017/expenseflow
# Cloud: mongodb+srv://<username>:<password>@cluster0.mongodb.net/expenseflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/expenseflow

# Authentication & JWT Configuration
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_IN_DAYS=7

# Email Service — Gmail SMTP (Welcome, Login security, Password reset, Budget alerts)
# 1. Enable 2-Step Verification on Gmail
# 2. Generate a 16-character App Password (Google Account -> Security -> App Passwords)
# 3. Paste the App Password as SMTP_PASS. Leave placeholder to log emails to console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM="ExpenseFlow <your_email@gmail.com>"

# AI Gateway (Google Gemini API - Free Tier: ₹0 Cost)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_free_google_gemini_api_key_here

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

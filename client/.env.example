# =================================================================
# EXPENSEFLOW FRONTEND CLIENT CONFIGURATION TEMPLATE
# Copy to client/.env if you need to point to a custom API host
# Leave blank during local development to use default /api Vite proxy
# =================================================================

# Optional Backend API Base URL (e.g. https://your-expenseflow-api.onrender.com)
# When unset or blank, the frontend connects to /api via reverse proxy or same domain.
VITE_API_URL=

# =================================================================
# EXPENSEFLOW ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env before starting the server
# =================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Configuration (Local MongoDB Community Edition)
MONGODB_URI=mongodb://localhost:27017/expenseflow

# Authentication & JWT Configuration
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_IN_DAYS=7

# Email Service — Gmail SMTP (register, login, logout, budget alerts)
# 1. Enable 2-Step Verification on the Gmail account
# 2. Create an App Password (Google Account → Security → App passwords)
# 3. Paste the 16-character App Password as SMTP_PASS (not your normal Gmail password)
# 4. Restart the server after saving. Leave placeholders to log emails to the console only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM="ExpenseFlow <your_email@gmail.com>"

# AI Gateway (Google Gemini API - Free Tier: ₹0 Cost)
GEMINI_API_KEY=your_free_google_gemini_api_key_here

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
